# ============================================================
# LLM-as-a-Judge Calibration Pipeline — Environment Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# -----------------------------------------------------------
# LLM Provider — hosted (OpenAI) or local (Ollama)
# -----------------------------------------------------------
# Hosted: "openai" | Local: "ollama"
MODEL_TYPE=hosted

# The model identifier used when calling the API
MODEL_NAME=gpt-4o-mini

# OpenAI-compatible API key (leave blank for Ollama)
OPENAI_API_KEY=sk-...

# Override base URL (useful for Azure, proxies, or Ollama)
# Ollama default: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------
# Budget guard — pipeline raises an exception if exceeded
# -----------------------------------------------------------
JUDGE_BUDGET_USD=5.00

# -----------------------------------------------------------
# Reproducibility
# -----------------------------------------------------------
RANDOM_SEED=42

# -----------------------------------------------------------
# Data paths (override for CI environments)
# -----------------------------------------------------------
LABELS_CSV=data/labels.csv
SPLITS_DIR=data/splits
RESULTS_DIR=results
PROMPTS_DIR=prompts
